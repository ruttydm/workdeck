    {
      "source_test": "keeps an older-series backport away from latest",
      "native_test": "older_series_backport_stays_away_from_latest"
    },
    {
      "source_test": "publishes prereleases under beta without changing latest",
      "native_test": "prereleases_use_beta_without_changing_latest"
    },
    {
      "source_test": "honors an explicit manual-dispatch tag",
      "native_test": "explicit_manual_dispatch_tag_is_honored"
    },
    {
      "source_test": "marks an explicit manual latest dispatch as latest",
      "native_test": "explicit_manual_latest_dispatch_is_latest"
    },
    {
      "source_test": "rejects republishing the current latest version",
      "native_test": "republishing_current_latest_is_rejected"
    },
    {
      "source_test": "rejects missing manual and stable-version inputs",
      "native_test": "missing_manual_and_stable_version_inputs_are_rejected"
    }
